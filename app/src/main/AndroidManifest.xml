<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 切换时在「对方应用」之上打一条提示，说明是本应用触发的 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 仅用于「检查更新」：访问 GitHub（或国内代理）取最新版本号并下载安装包。
         除这条链路外应用不发起任何网络请求，也不上传任何数据。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.miui.gallery" />
        <package android:name="com.miui.securitycenter" />
        <!-- 让应用列表页能看到所有带启动图标的应用（Android 11+ 包可见性） -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- excludeFromRecents 改由运行时开关控制：清单里写 false，
             是否隐藏交给「任务切换页隐藏」这个开关（且必须先完成上锁教程）。
             否则清单写死 true 的话，用户关掉开关也看不到卡片。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开场叙事：首启放一次，播完淡出进首页。横向横竖屏都不重建，动画不会被打断 -->
        <activity
            android:name=".IntroActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/AppTheme" />

        <!-- 所有页面都声明 configChanges：系统深浅色切换时只回调 onConfigurationChanged，
             不会被销毁重建。重建会让「自检」这类页面反复执行初始化，形成闪屏死循环。 -->
        <activity
            android:name=".GuideActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/guide_title" />

        <activity
            android:name=".ShizukuGuideActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/shizuku_title" />

        <activity
            android:name=".LockGuideActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/lock_title" />

        <activity
            android:name=".AppPickerActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="选择应用"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CheckActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/check_title" />

        <activity
            android:name=".ContactActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="联系作者" />

        <activity
            android:name=".TipActivity"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="请我喝瓶大水" />

        <service
            android:name=".WatchAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 常驻通知：Android 14+ 必须声明前台服务类型，specialUse 是唯一贴切的通用类型 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="switches the system dark theme while chosen apps are in the foreground" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 只把下载好的安装包交给系统安装器读，别的一概不给 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
