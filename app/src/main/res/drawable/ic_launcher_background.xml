<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景：斜向深靛渐变。系统会按各厂商的形状（圆/方/水滴/异形）裁切，
     背景铺满 108x108，任何遮罩都不会露白。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="4"
                android:endX="100"
                android:endY="104">
                <item android:offset="0" android:color="#FF4B5579" />
                <item android:offset="0.55" android:color="#FF2A2F45" />
                <item android:offset="1" android:color="#FF161821" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶部一抹极淡的月光，避免大面积纯色显得死板 -->
    <path android:pathData="M0,0h108v52c-30,10 -70,10 -108,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="56">
                <item android:offset="0" android:color="#22FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
